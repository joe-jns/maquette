{
  "name": "maquette",
  "version": "0.1.0",
  "private": true,
  "description": "Éditeur de maquettes de sites, style Figma, piloté par Claude Code",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "update-taste": "node scripts/update-taste-skill.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "immer": "11.1.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-static": "1.59.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "author": "Joakim Janssens"
}
